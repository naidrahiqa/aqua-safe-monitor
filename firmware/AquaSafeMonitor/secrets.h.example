#ifndef SECRETS_H
#define SECRETS_H

// ===================================================================
// Copy this file to "secrets.h" (same folder) and fill in real values.
// secrets.h must stay OUT of git — add it to .gitignore.
// ===================================================================

// WiFi the device should connect to when in range (e.g. at home/school,
// not necessarily at the water sampling site).
#define WIFI_SSID     "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// (Optional) Fallback WiFi — tried if primary fails.
// #define WIFI_SSID_2     "YOUR_SECOND_WIFI"
// #define WIFI_PASSWORD_2 "YOUR_SECOND_PASSWORD"
// #define WIFI_SSID_3     "YOUR_THIRD_WIFI"
// #define WIFI_PASSWORD_3 "YOUR_THIRD_PASSWORD"

// From the web dashboard: log in -> Devices -> Add Device.
// It shows a ready-to-copy snippet with these two lines pre-filled —
// paste it here as-is.
#define API_KEY  "PASTE_DEVICE_SECRET_API_KEY_HERE"
#define ENDPOINT "https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-sensor-data"

// Only needed if supabase/config.toml's verify_jwt=false was NOT applied
// to the ingest-sensor-data function (see SETUP_CHECKLIST.md). If you
// did apply it, leave this commented out — one less secret to manage.
// #define SUPABASE_ANON_KEY "YOUR_ANON_KEY_FROM_SUPABASE_DASHBOARD"

#endif
